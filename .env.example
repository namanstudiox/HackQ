# Supabase — create a project at https://supabase.com, then grab these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth — in Authentication → URL Configuration, set:
#   Site URL:  http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
# Email confirmation is ON by default, which is exactly the flow we want:
# signup → verification link in the user's inbox → click → session.

# Featherless AI (https://featherless.ai) — key from Account → API keys.
# Powers the @HackQ teammate and voice-note analysis.
FEATHERLESS_API_KEY=
# Optional overrides — defaults: Qwen/Qwen3-8B (chat) + openai/whisper-large-v3-turbo (ASR).
FEATHERLESS_MODEL=
FEATHERLESS_ASR_MODEL=

# Voice-note AI analysis (transcribe → plan) is OFF by default. Set to "true"
# to re-enable the ⚡ button and the /api/ai/voice endpoint.
ENABLE_VOICE_AI=
