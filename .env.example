# Supabase — create a project at https://supabase.com, then grab these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth — in Authentication → URL Configuration, set:
#   Site URL:  http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
# Email confirmation is ON by default, which is exactly the flow we want:
# signup → verification link in the user's inbox → click → session.
